{
  "$schema": "./schemas/customization.schema.json",
  "format": "git-template-customization",
  "formatVersion": "0.2.0",
  "entries": [
    {
      "id": "brand",
      "title": "修改品牌与主题",
      "description": "品牌、股票示例、持仓计算与主题分别维护，中英文同步修改。",
      "files": [
        {
          "path": "src/features/site-templates/catalog/cryptocalc/config/brand.ts",
          "kind": "file",
          "purpose": "品牌名称与标语"
        },
        {
          "path": "src/features/site-templates/catalog/cryptocalc/content/data.ts",
          "kind": "file",
          "purpose": "双语文案和数据"
        },
        {
          "path": "src/features/site-templates/catalog/cryptocalc/theme.css",
          "kind": "file",
          "purpose": "主题令牌和响应式样式"
        },
        {
          "path": "src/features/site-templates/catalog/cryptocalc/position.ts",
          "kind": "file",
          "purpose": "持仓市值、成本与盈亏规则"
        }
      ],
      "constraints": [
        "保留双语和原有路由兼容",
        "固定美元示例不可描述为实时行情",
        "不连接真实证券账户或执行交易"
      ],
      "checks": [
        "typecheck",
        "lint",
        "build"
      ]
    }
  ]
}
